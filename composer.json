{
    "name": "nvl/laravel-suite",
    "description": "Composer composition of all NVL Laravel Suite packages",
    "type": "metapackage",
    "license": "MIT",
    "homepage": "https://github.com/nvl-laravel-suite/laravel-suite",
    "require": {
        "nvl/activity": "^6.0",
        "nvl/auth": "^6.0",
        "nvl/comments": "^6.0",
        "nvl/content": "^6.0",
        "nvl/core": "^6.0",
        "nvl/csv": "^6.0",
        "nvl/filterable": "^6.0",
        "nvl/forms": "^6.0",
        "nvl/mail-notifications": "^6.0",
        "nvl/media": "^6.0",
        "nvl/metafields": "^6.0",
        "nvl/ownership": "^6.0",
        "nvl/pages": "^6.0",
        "nvl/primitives": "^6.0",
        "nvl/seo": "^6.0",
        "nvl/settings": "^6.0",
        "nvl/tasks": "^6.0",
        "nvl/taxonomy": "^6.0",
        "nvl/templates": "^6.0",
        "nvl/translatable": "^6.0",
        "nvl/translations": "^6.0",
        "php": "^8.4"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "6.x-dev"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "authors": [
        {
            "name": "Nicolas Vlachos",
            "homepage": "https://github.com/nicolasvlachos",
            "role": "Developer"
        }
    ],
    "support": {
        "source": "https://github.com/nvl-laravel-suite/laravel-suite",
        "docs": "https://github.com/nvl-laravel-suite/laravel-suite#readme",
        "issues": "https://github.com/nvl-laravel-suite/laravel-suite/issues",
        "security": "https://github.com/nvl-laravel-suite/laravel-suite/security/policy"
    },
    "archive": {
        "exclude": [
            "/.gitattributes",
            "/**/.gitattributes",
            "/.gitignore",
            "/**/.gitignore",
            "/**/.gitkeep"
        ]
    },
    "suggest": {
        "nvl/tenancy": "Temporary compatibility bridge; install and select it explicitly for a legacy tenant application."
    },
    "conflict": {
        "nvl/tenancy": "<6.0 || >=7.0"
    }
}

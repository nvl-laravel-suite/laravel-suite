{
    "name": "nvl/laravel-suite",
    "description": "Composer composition of all NVL Laravel Suite packages",
    "type": "metapackage",
    "license": "MIT",
    "homepage": "https://github.com/nvl-laravel-suite",
    "require": {
        "php": "^8.4",
        "nvl/activity": "^5.0",
        "nvl/auth": "^5.0",
        "nvl/comments": "^5.0",
        "nvl/content": "^5.0",
        "nvl/core": "^5.0",
        "nvl/csv": "^5.0",
        "nvl/filterable": "^5.0",
        "nvl/forms": "^5.0",
        "nvl/mail-notifications": "^5.0",
        "nvl/media": "^5.0",
        "nvl/metafields": "^5.0",
        "nvl/pages": "^5.0",
        "nvl/primitives": "^5.0",
        "nvl/seo": "^5.0",
        "nvl/settings": "^5.0",
        "nvl/tasks": "^5.0",
        "nvl/taxonomy": "^5.0",
        "nvl/templates": "^5.0",
        "nvl/tenancy": "^5.0",
        "nvl/translatable": "^5.0",
        "nvl/translations": "^5.0"

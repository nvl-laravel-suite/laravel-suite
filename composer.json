{
    "name": "nvl/laravel-suite",
    "description": "Composer composition of all NVL Laravel Suite packages",
    "type": "metapackage",
    "license": "MIT",
    "homepage": "https://github.com/nvl-laravel-suite/laravel-suite",
    "require": {
        "nvl/activity": "^7.0",
        "nvl/auth": "^7.0",
        "nvl/auth-identity-bridge": "^7.0",
        "nvl/comments": "^7.0",
        "nvl/content": "^7.0",
        "nvl/core": "^7.0",
        "nvl/csv": "^7.0",
        "nvl/filterable": "^7.0",
        "nvl/forms": "^7.0",
        "nvl/mail-notifications": "^7.0",
        "nvl/media": "^7.0",
        "nvl/metafields": "^7.0",
        "nvl/ownership": "^7.0",
        "nvl/pages": "^7.0",
        "nvl/primitives": "^7.0",
        "nvl/seo": "^7.0",
        "nvl/settings": "^7.0",
        "nvl/tasks": "^7.0",
        "nvl/taxonomy": "^7.0",
        "nvl/templates": "^7.0",
        "nvl/translatable": "^7.0",
        "nvl/translations": "^7.0",
        "php": "^8.4"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "7.x-dev"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "authors": [
        {
            "name": "Nicolas Vlachos",
            "homepage": "https://github.com/nicolasvlachos",
            "role": "Developer"
        }
    ],
    "support": {
        "source": "https://github.com/nvl-laravel-suite/laravel-suite",
        "docs": "https://github.com/nvl-laravel-suite/laravel-suite#readme",
        "issues": "https://github.com/nvl-laravel-suite/laravel-suite/issues",
        "security": "https://github.com/nvl-laravel-suite/laravel-suite/security/policy"
    },
    "archive": {
        "exclude": [
            "/.gitattributes",
            "/**/.gitattributes",
            "/.gitignore",
            "/**/.gitignore",
            "/**/.gitkeep",
            "/.DS_Store",
            "/**/.DS_Store",
            ".DS_Store"
        ]
    },
    "suggest": {},
    "conflict": {}
}
